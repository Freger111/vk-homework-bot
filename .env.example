# === VK ===
# Токен сообщества (Long Poll). Нужны права «Управление сообществом» и «Сообщения сообщества».
VK_TOKEN=
# ID сообщества (только число)
VK_GROUP_ID=

# === Основной LLM (Gemini) ===
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash

# === Запасной LLM (OpenRouter) ===
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free

# Системный промпт (можно не задавать — будет стандартный)
# SYSTEM_PROMPT=
