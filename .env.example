# === VK ===
# Токен сообщества. Нужны права «Управление сообществом», «Сообщения сообщества»
# и «Фотографии» (для отправки графиков и дорисованных фото).
VK_TOKEN=
# ID сообщества (только число)
VK_GROUP_ID=
# VK ID или username администратора — для кнопки «Помощь»
ADMIN_VK=
# Числовой VK ID администратора — для админ-команд (/stats, /ban, ...)
ADMIN_ID=
# Бесплатных задач в день (по умолчанию 5)
FREE_LIMIT=5

# === Основной LLM (Gemini) ===
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash

# === Запасной LLM (OpenRouter) ===
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free

# Системный промпт (можно не задавать — будет стандартный)
# SYSTEM_PROMPT=
